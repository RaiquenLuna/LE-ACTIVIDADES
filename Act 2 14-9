#include <stdio.h>
#include <string.h>

#define CANTIDAD 3

struct Alumno
{
    char nombre[50];
    int edad;
    int año;
};

int main(void)
{
    struct Alumno alumnos[CANTIDAD];
    int i;

    printf("CARGA DE DATOS DE LOS ALUMNOS\n");

    for (i = 0; i < CANTIDAD; i++)
    {
        printf("\nAlumno %d\n", i + 1);

        printf("Ingrese el nombre: ");
        fgets(alumnos[i].nombre, sizeof(alumnos[i].nombre), stdin);

        alumnos[i].nombre[strcspn(alumnos[i].nombre, "\n")] = '\0';

        printf("Ingrese la edad: ");
        scanf("%d", &alumnos[i].edad);

        printf("Ingrese el año al que pertenece: ");
        scanf("%d", &alumnos[i].año);


        while (getchar() != '\n')
        {
        }
    }

    printf("\nDATOS MODIFICADOS POR EL USUARIO\n");

    for (i = 0; i < CANTIDAD; i++)
    {
        printf("\nAlumno %d\n", i + 1);
        printf("Nombre: %s\n", alumnos[i].nombre);
        printf("Edad: %d\n", alumnos[i].edad);
        printf("Año al que pertenece: %d\n", alumnos[i].año);
    }

    return 0;
}
