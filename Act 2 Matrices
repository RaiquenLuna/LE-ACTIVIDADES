#include <stdio.h>

int main() {
    int matriz[3][2][2];

    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 2; j++) {
            for(int k = 0; k < 2; k++) {
                printf("Ingrese [%d][%d][%d\]: ", i, j, k);
                scanf("%d", &matriz[i][j][k]);
            }
        }
    }


    for(int i = 0; i < 3; i++) {
        printf("\nTabla %d:\n", i + 1);

        for(int j = 0; j < 2; j++) {
            for(int k = 0; k < 2; k++) {
                printf("%d\t", matriz[i][j][k]);
            }
            printf("\n");
        }
    }

    return 0;
}
