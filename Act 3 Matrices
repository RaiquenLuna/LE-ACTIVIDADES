#include <stdio.h>

int main() {
    int tabla[4][4];

    for(int i = 0; i < 4; i++) {
        printf("Ingrese A: ");
        scanf("%d", &tabla[i][0]);

        printf("Ingrese B: ");
        scanf("%d", &tabla[i][1]);

        tabla[i][2] = tabla[i][0] && tabla[i][1]; 
        tabla[i][3] = tabla[i][0] || tabla[i][1]; 
    }

    printf("\nA B AND OR\n");

    for(int i = 0; i < 4; i++) {
        printf("%d %d %d   %d\n",
               tabla[i][0],
               tabla[i][1],
               tabla[i][2],
               tabla[i][3]);
    }

    return 0;
}
