#include <stdio.h>

#define TAMANO 10

void cargarVector(int vector[], int tamano);
void ordenarMayorAMenor(int vector[], int tamano);
void mostrarVector(int vector[], int tamano);
int sumarVector(int vector[], int tamano);
float calcularPromedio(int suma, int tamano);

int main(void)
{
    int vector[TAMANO];
    int suma;
    float promedio;

    cargarVector(vector, TAMANO);

    ordenarMayorAMenor(vector, TAMANO);

    printf("\nVECTOR ORDENADO DE MAYOR A MENOR:\n");
    mostrarVector(vector, TAMANO);

    suma = sumarVector(vector, TAMANO);

    promedio = calcularPromedio(suma, TAMANO);

    printf("\nSuma total: %d\n", suma);
    printf("Promedio: %.2f\n", promedio);

    return 0;
}

void cargarVector(int vector[], int tamano)
{
    int i;

    printf("Ingrese %d valores:\n", tamano);

    for (i = 0; i < tamano; i++)
    {
        printf("Valor %d: ", i + 1);
        scanf("%d", &vector[i]);
    }
}

void ordenarMayorAMenor(int vector[], int tamano)
{
    int i;
    int j;
    int auxiliar;

    for (i = 0; i < tamano - 1; i++)
    {
        for (j = 0; j < tamano - 1 - i; j++)
        {
            if (vector[j] < vector[j + 1])
            {
                auxiliar = vector[j];
                vector[j] = vector[j + 1];
                vector[j + 1] = auxiliar;
            }
        }
    }
}

void mostrarVector(int vector[], int tamano)
{
    int i;

    for (i = 0; i < tamano; i++)
    {
        printf("vector[%d] = %d\n", i, vector[i]);
    }
}

int sumarVector(int vector[], int tamano)
{
    int i;
    int suma = 0;

    for (i = 0; i < tamano; i++)
    {
        suma = suma + vector[i];
    }

    return suma;
}

float calcularPromedio(int suma, int tamano)
{
    return (float)suma / tamano;
}
